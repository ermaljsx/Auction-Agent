# Auction-Agent settings. Copy this file to ".env" in the same folder and fill it in:
#   cmd:        copy .env.example .env   then   notepad .env
#   PowerShell: Copy-Item .env.example .env   then   notepad .env
# ".env" is git-ignored: never put a real key in this example file, and check that
# Windows did not save it as ".env.txt". Variables already set in your system
# environment take precedence over this file.

# Optional AI review. Leave the key empty to score with the rules only.
# Default: Anthropic Claude (claude-haiku-5-5). Create a key in the Claude Console
# (https://platform.claude.com), ideally in a workspace with a monthly spend limit,
# then paste it after the "=" sign, without quotes.
ANTHROPIC_API_KEY=

# LLM_PROVIDER=anthropic          # "anthropic" (default) or "openai" (fallback below)
# LLM_MODEL=claude-haiku-5-5      # default model of the chosen provider
# LLM_REASONING_EFFORT=low        # Claude: none (no thinking, cheapest), low, medium or high
# LLM_LIMIT=80                    # maximum cars sent to the AI per run (about 50 are listed)

# Fallback: OpenAI. To switch back, set LLM_PROVIDER=openai and fill in the key
# (https://platform.openai.com/api-keys, in a project with a hard monthly spend limit).
# LLM_MODEL then defaults to gpt-6-luna and LLM_REASONING_EFFORT to none
# (OpenAI: none is the cheapest; "off" only for a model without reasoning).
# OPENAI_API_KEY=

# Weekly snapshot for the website (private Vercel Blob store "auction-agent-state").
# Vercel dashboard -> Storage -> auction-agent-state -> copy the read-write token
# (it starts with vercel_blob_rw_). Without it, "publish" can only write a local copy (--out).
BLOB_READ_WRITE_TOKEN=
