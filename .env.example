# Auction-Agent settings. Copy this file to ".env" in the same folder and fill it in:
#   cmd:        copy .env.example .env   then   notepad .env
#   PowerShell: Copy-Item .env.example .env   then   notepad .env
# ".env" is git-ignored: never put a real key in this example file, and check that
# Windows did not save it as ".env.txt". Variables already set in your system
# environment take precedence over this file.

# Optional AI review (OpenAI). Leave empty to score with the rules only.
# Create a key at https://platform.openai.com/api-keys (ideally in a dedicated project
# with a hard monthly spend limit), then paste it after the "=" sign, without quotes.
OPENAI_API_KEY=

# Model and reasoning effort (defaults shown). Effort "none" is the cheapest.
# LLM_MODEL=gpt-6-luna
# LLM_REASONING_EFFORT=none
# Maximum vehicles sent to the AI per run:
# LLM_LIMIT=60
