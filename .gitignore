# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
# Local settings files (.env.txt is what Windows Notepad often saves); keep the template
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Local data: databases (+ WAL/SHM), identity key, quarantine, legacy PDFs
data/*
!data/.gitkeep
!data/documents/
data/documents/*
!data/documents/.gitkeep

# Real captured fixtures may contain personal data until reviewed
tests/fixtures/alcopa/real/

# Generated reports
reports/*.html
!reports/.gitkeep

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Real CT texts used by tests/test_ct_real_conformance.py: they name CT centres and controllers
tests/fixtures/ct/real/

# Real battery-certificate texts used by tests/test_battery_real_conformance.py (git-ignored like the CT texts)
tests/fixtures/battery/real/

# Never publish secrets, databases or local tool state (the repository is public)
*.env
*.bak
*.db
*.sqlite
*.sqlite3
*.pem
*.key
.vercel/
.claude/settings.local.json
.pytest_cache/
